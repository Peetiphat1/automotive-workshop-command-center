# ──────────────────────────────────────────────────────────────────────────────
# Automotive Workshop Command Center  —  Environment Variables
# Copy this file to .env and adjust for your environment
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME="Automotive Workshop Command Center"
API_VERSION="v1"
DEBUG=true

# Database (swap to postgresql+psycopg2://user:pass@host/db for production)
DATABASE_URL="sqlite:///./workshop_demo.db"

# HITL Guardrail Thresholds
QUOTE_APPROVAL_THRESHOLD_THB=3000.0
CUSTOMER_INACTIVE_MONTHS=6
OIL_CHANGE_KM=10000
OIL_CHANGE_MONTHS=6
BATTERY_CHANGE_YEARS=2
TIRE_CHANGE_KM=40000

# Security — shop login password. Off by default; set REQUIRE_PASSWORD=true to ask for MOCK_API_KEY
# on the dashboard, stock and scan pages (recommended if other people use your Wi-Fi).
REQUIRE_PASSWORD=false
MOCK_API_KEY="workshop-secret-2026"

# LINE OA  (mock — no real dispatch)
LINE_OA_CHANNEL_TOKEN="MOCK_LINE_TOKEN"
# Channel secret from the LINE Developers console — the webhook rejects messages without a valid signature
LINE_OA_CHANNEL_SECRET=""
LINE_OA_MOCK_URL="https://api.line.me/v2/bot/message/push"
